# Runtime settings managed by fastdup-agent after repository provisioning.
# Static safety settings live in fastdup-repository.service so replacing this
# file through the WebUI cannot weaken them.
FASTDUP_ADVANCED_REDUCTION=off
FASTDUP_ONLINE_GC_ENABLED=1
FASTDUP_ONLINE_GC_PRESSURE_LOW_BASIS_POINTS=8500
FASTDUP_ONLINE_GC_PRESSURE_HIGH_BASIS_POINTS=9200
FASTDUP_SMALL_FILE_POLICY_REVISION=settings-1
FASTDUP_SMALL_FILE_EXTENSIONS=.json,.xml
