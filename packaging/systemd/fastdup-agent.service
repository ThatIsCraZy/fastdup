[Unit]
Description=FastDup privileged appliance agent
After=local-fs.target
Before=fastdup-control.service

[Service]
Type=simple
Slice=fastdup-management.slice
ExecStart=/usr/libexec/fastdup/fastdup-agent
User=root
Group=fastdup-control
UMask=0007
RuntimeDirectory=fastdup
RuntimeDirectoryMode=0770
NoNewPrivileges=yes
# smbcontrol discovers local interfaces via rtnetlink before it sends its
# local messaging request. The agent itself still exposes only its Unix socket.
RestrictAddressFamilies=AF_UNIX AF_NETLINK
OOMScoreAdjust=500
Restart=on-failure
RestartSec=2s

[Install]
WantedBy=multi-user.target
